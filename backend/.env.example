# Copiar a .env y completar. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000

# --- MySQL local (XAMPP): usuario root sin contraseña por defecto ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spotcheck
# --- Railway: usar la URL del plugin MySQL (tiene prioridad sobre las variables DB_*) ---
# MYSQL_URL=mysql://user:pass@host:port/railway

# --- Tokens (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CODE_TTL_MIN=15          # vigencia de los códigos de 6 dígitos (correo / reset / acción sensible)
SENSITIVE_TTL_MIN=5      # vigencia del token de verificación adicional
BCRYPT_COST=12
TRUST_PROXY=1            # Railway está detrás de 1 proxy
CORS_ORIGINS=            # lista separada por comas; vacío = sin CORS. La app móvil no lo necesita; para la versión web en desarrollo: http://localhost:8081

# --- Correo (Resend) ---
RESEND_API_KEY=
MAIL_FROM=SPOTCHECK <onboarding@resend.dev>

# --- Imágenes en disco del servidor. En Railway apuntar al volumen montado (ej. /data/uploads) ---
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# --- OAuth (secretos SOLO aquí, nunca en la app móvil). Se detalla en docs/OAUTH.md ---
# Destinos permitidos para volver a la app (lista separada por comas). En desarrollo con Expo Go agregar su URL exp://
OAUTH_APP_REDIRECTS=spotcheck://auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
