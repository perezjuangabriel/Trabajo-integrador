{
  "expo": {
    "name": "SPOTCHECK",
    "slug": "spotcheck",
    "version": "1.0.0",
    "scheme": "spotcheck",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "android": {
      "package": "com.spotcheck.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "SPOTCHECK necesita acceder a tus fotos para adjuntarlas a spots, productos y reseñas."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "518006b7-9533-4c63-86f0-63fe366eedb3"
      }
    },
    "owner": "juangabriel08"
  }
}
